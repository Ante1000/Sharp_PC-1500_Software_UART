; SERIN v7.1 - listing (addresses relative to SI = RAM+&130), 162 bytes
;
                 ; =====================================================================
                 ; SERIN v7.1 - software UART receiver 8N1 for the Sharp PC-1500(A),
                 ; 19200 bps, input PB0 (pin 9) or PB2 (CMT-IN, pin 27), normal polarity
                 ; (TTL: idle = high) or inverted (idle = low) - chosen in the installer.
                 ; CPU LH5801 @ 1.3 MHz.
                 ;
                 ; Call from BASIC (as in v6.x):
                 ;   CALL SI          receive up to 255 characters
                 ;   CALL SI,M        receive at most M characters (1..255; 0 or >255 = 255)
                 ; Result:
                 ;   RC               number of characters received, 1 byte, RC = RX-1
                 ;   RX..RX+254       the characters (RX = start of a memory page, &4200)
                 ;   M                (only with CALL SI,M) = number of characters received
                 ; Time limits: the first character must come within ~30 s, the next ones
                 ; within ~0.5 s of each other; after the M-th (or 255th) character the
                 ; routine returns at once.
                 ;
                 ; Timing (MAME cycle table, 1 cycle = 0.769 us; 19200 bps = 67.7 cycles).
                 ; The calibration on a real PC-1500 measured 73.4 real cycles between two
                 ; samples of SERIN v7.0 with RB = 70 (3.4 more than MAME) and the first
                 ; sample 7 cycles too early for RB = 64; v7.1 has the defaults RB = 64 and
                 ; RQ = 22 and a later range for RQ.
                 ; - Bit loop: RB = 51 + PAD R cycles (R = 12..20: RB = 63..71, default 64).
                 ;   Both paths (bit 0 / bit 1) take the same time. Counter: sentinel in A
                 ;   (LDI A,&80; after 8 ROR the 1 leaves into C), so no DEC/branch per bit.
                 ; - Start bit: the waiting loop polls the line every 33 cycles (with the
                 ;   time-out counter) - half a bit at 19200, so the edge is known to about
                 ;   +-1/4 bit. After each character 7 fast polls without a counter follow
                 ;   (every 22 cycles, edge known to about +-1/6 bit): characters sent
                 ;   back to back are caught there. FSTART adds 5 cycles for the fast
                 ;   polls, so both entries sample at the same place.
                 ; - RQ = 8 + PAD Q cycles (Q = 8 or 12..20: RQ = 16 or 20..28, default 22)
                 ;   moves all samples: the first data bit is read about 1.5 bits after the
                 ;   start edge.
                 ; - The middle of the start bit is checked (noise filter), as in v6.x.
                 ; - DEC sets C when the value was not 0 before, and BII does not change C,
                 ;   so polls can sit between DEC and the BCS that tests it: no long gaps.
                 ; Branches that depend on the line are pseudo instructions whose opcode
                 ; the installer writes (BZR and BZS take the same time):
                 ;   BMK+ = FM  forward if mark   (normal BZR+ &89 / inverted BZS+ &8B)
                 ;   BSP+ = FS  forward if space  (normal BZS+ &8B / inverted BZR+ &89)
                 ;   BMK- = RM  back if mark      (normal BZR- &99 / inverted BZS- &9B)
                 ;   BSP- = RS  back if space     (normal BZS- &9B / inverted BZR- &99)
                 ; Other BASIC variables written by the installer:
                 ;   DB = &FE (PB0) / &FB (PB2)   mask for the direction register DDB
                 ;   BM = 1 (PB0) / 4 (PB2)       bit mask of the input in port B (&F00F)
                 ;   Q1..Q4, R1..R4               timing pads (sample position, bit length)
                 ;   RP = page of the RX buffer, CP = RP-1 (page of RC and of this code)
                 ;
                 ; Load address: SI = RAM+&130 (&4130). M is written into the CPI XL,M
                 ; below (the code changes one of its own bytes, at SI+CMPM+1).
                 ; =====================================================================
00  FD BE                RIE                     ; no interrupts (timing!)
02  84                   LDA  XH                 ; no variable (ROM address) or M > 255
03  89 03                BZR+ MAXM               ;   -> 255 characters
05  04                   LDA  XL                 ; CALL SI,M: X = M
06  89 02                BZR+ SETM               ; M = 1..255
08  B5 FF        MAXM:   LDI  A,&FF              ; M = 0 -> 255 (whole buffer)
0A  AE CP 9E     SETM:   STA  (CP,&30+CMPM+1)    ; M into CPI XL,M (SI = RAM+&130)
0D  48 RP                LDI  XH,RP              ; X = RX (start of a page)
0F  4A 00                LDI  XL,0
11  58 F0                LDI  YH,&F0             ; Y = &F00D (DDB, direction register of port B)
13  5A 0D                LDI  YL,&0D
15  FD 59 DB             ANI  #(Y),DB            ; PB0 or PB2 = input
18  5A 0F                LDI  YL,&0F             ; Y = &F00F (port B)
1A  68 FF                LDI  UH,255             ; time-out of the 1st character:
1C  B5 11                LDI  A,17               ; 18*256*256 polls, about 30 s
1E  FD 5D BM     WH:     BII  #(Y),BM            ; wait for the idle level (mark)
21  FM 0B                BMK+ WL
23  88 07                LOP  UL,WH
25  FD 62                DEC  UH
27  93 0B                BCS- WH
29  DF                   DEC  A
2A  93 0E                BCS- WH
2C  8E 6C                BCH+ DONE               ; time-out
2E  FD 5D BM     WL:     BII  #(Y),BM            ; wait for the start bit (space), poll every 33 cycles
31  FS 1B                BSP+ SSTART
33  88 07                LOP  UL,WL
35  FD 5D BM             BII  #(Y),BM            ; UL ran out: keep polling between the counters
38  FS 14                BSP+ SSTART
3A  FD 62                DEC  UH
3C  FD 5D BM             BII  #(Y),BM
3F  FS 0D                BSP+ SSTART
41  93 15                BCS- WL
43  DF                   DEC  A
44  FD 5D BM             BII  #(Y),BM
47  FS 05                BSP+ SSTART
49  93 1D                BCS- WL
4B  8E 4D                BCH+ DONE               ; time-out
4D  38           FSTART: NOP                     ; entry from the fast polls (edge known better)
4E  FD 5D BM     SSTART: BII  #(Y),BM            ; middle of the start bit: still space?
51  RM 25                BMK- WL                 ; no: noise, wait again
53  B5 80                LDI  A,&80              ; sentinel: leaves into C after 8 bits
55  8E 00                BCH+ SQ                 ; 8 cycles: RQ = 8 + pad Q
57  Q1 Q2 Q3 Q4  SQ:     PAD  4,Q                ; timing: position of the samples
5B  R1 R2 R3 R4  BIT:    PAD  4,R                ; timing: length of a bit
5F  FD 5D BM             BII  #(Y),BM            ; read the bit
62  FS 03                BSP+ ZERO
64  FB                   SEC                     ; mark: 1
65  8E 02                BCH+ JOIN
67  F9           ZERO:   REC                     ; space: 0
68  38                   NOP                     ; (both paths 34 cycles)
69  D1           JOIN:   ROR                     ; LSB first; C = sentinel after the 8th bit
6A  91 11                BCR- BIT
6C  41                   SIN  X                  ; store the character, X++
6D  4E 00        CMPM:   CPI  XL,0               ; M characters received? (M written at the start)
6F  8B 29                BZS+ DONE
71  68 4C                LDI  UH,76              ; time-out between characters:
73  B5 00                LDI  A,0                ; 77*256 polls, about 0.5 s
75  FD 5D BM             BII  #(Y),BM            ; 7 fast polls for the next start bit; the
78  RS 2D                BSP- FSTART             ; first one about 1.2 bits after the last
7A  FD 5D BM             BII  #(Y),BM            ; data bit was read, before the next start
7D  RS 32                BSP- FSTART             ; bit of characters sent back to back
7F  FD 5D BM             BII  #(Y),BM
82  RS 37                BSP- FSTART
84  FD 5D BM             BII  #(Y),BM
87  RS 3C                BSP- FSTART
89  FD 5D BM             BII  #(Y),BM
8C  RS 41                BSP- FSTART
8E  FD 5D BM             BII  #(Y),BM
91  RS 46                BSP- FSTART
93  FD 5D BM             BII  #(Y),BM
96  RS 4B                BSP- FSTART
98  9E 6C                BCH- WL                 ; then the polls with the time-out
9A  04           DONE:   LDA  XL                 ; number of characters = XL (RX starts a page)
9B  AE CP FF             STA  (CP,&FF)           ; RC = number of characters
9E  48 00                LDI  XH,0               ; X = number of characters ...
A0  FB                   SEC                     ; ... C=1: BASIC puts X into the variable of CALL SI,M
A1  9A                   RTN
