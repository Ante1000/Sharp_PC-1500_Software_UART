; SEROUT v7.0 - listing (addresses relative to SO = RAM+&0C5), 82 bytes
;
                 ; =====================================================================
                 ; SEROUT v7.0 - software UART transmitter 8N1 for the Sharp PC-1500(A),
                 ; 19200 bps, normal or inverted polarity (chosen in the installer).
                 ; CPU LH5801 @ 1.3 MHz, output PC7 (&F008 bit 7).
                 ;   normal (TTL):  idle and bit "1" = high, start bit and "0" = low
                 ;   inverted:      idle and bit "1" = low,  start bit and "0" = high
                 ;
                 ; Call from BASIC (as in v6.x):
                 ;   CALL SO          send 1 character from TX+0
                 ;   CALL SO,N        send N characters from TX+0.. (1..255; 0 = 1, >255 = 255)
                 ; The variable N is NOT changed (returns with C=0).
                 ; TX buffer: 255 bytes at the start of a memory page (TX = RAM+&300).
                 ;
                 ; Timing (cycle counts from MAME's LH5801 table; 1 cycle = 0.769 us).
                 ; 19200 bps = 67.7 cycles per bit. On a real PC-1500 every ORI/ANI on a
                 ; port takes about 1.9 cycles longer than in MAME (measured with the I2C
                 ; master), so one data bit = TB + ~1.9 cycles, with
                 ;   TB = 57 + PAD   (PAD = 6..10 cycles: TB = 63..67, default 66).
                 ; The installer writes the PAD (2 bytes, P1 P2) for the TB it is given;
                 ; the calibration with the Arduino sketch finds the best TB.
                 ; The bit loop has no delay loop (v6.x: LDI+LOP), which made it too slow:
                 ; both branches (bit 0 / bit 1) take 33 cycles; the port write comes 3
                 ; cycles later for a 1 bit than for a 0 bit, which moves single edges by
                 ; 2.3 us but does not add up over the frame.
                 ; Start bit = TB (fixed 22 cycles + the same PAD), last data bit = TB
                 ; (+11 cycles after the loop), stop bit = 57 + 11*KT cycles (KT = 1:
                 ; 68 cycles = 1.03 bits).
                 ; Writes to PC7 are the pseudo instructions MARK / SPACE (FD op imm):
                 ;   MARK  #(Y) = FD OM VM   normal ORI #(Y),&80, inverted ANI #(Y),&7F
                 ;   SPACE #(Y) = FD OS VS   normal ANI #(Y),&7F, inverted ORI #(Y),&80
                 ; Bit counter: sentinel - SEC+ROR puts a 1 into bit 7; after the eighth
                 ; SHR A = 0. Z is tested with BII A,&FF (the LH5801 manual says that
                 ; shifts do not set Z). Character counter in UH (1..255).
                 ;
                 ; Load address: SO = RAM+&0C5 (&40C5).
                 ; Symbols filled in by BASIC: TP = high byte of the TX buffer address,
                 ; KI = idle before the first start bit, KT = stop bit, P1 P2 = timing pad,
                 ; OM/VM/OS/VS = polarity (see above).
                 ; =====================================================================
00  FD BE                RIE                 ; no interrupts (timing!)
02  84                   LDA  XH
03  8B 08                BZS+ SMALL          ; N = 0..255
05  BF 80                BII  A,&80          ; CALL SO without a variable: X = ROM address (XH>=&80)
07  89 07                BZR+ N1             ;   -> 1 character
09  B5 FF                LDI  A,&FF          ; N = 256..32767 -> 255
0B  8E 05                BCH+ NOK
0D  04           SMALL:  LDA  XL
0E  89 02                BZR+ NOK            ; N = 1..255
10  B5 01        N1:     LDI  A,1            ; N = 0 -> 1 character
12  28           NOK:    STA  UH             ; UH = number of characters (1..255)
13  48 TP                LDI  XH,TP          ; X = TX buffer (start of a page)
15  4A 00                LDI  XL,0
17  58 F0                LDI  YH,&F0         ; Y = &F008 (port C)
19  5A 08                LDI  YL,&08
1B  FD OM VM             MARK #(Y)           ; PC7 = idle (mark) ...
1E  6A KI                LDI  UL,KI          ; ... for about 1 bit before the first start bit
20  88 02        IDLE:   LOP  UL,IDLE
22  45           CHAR:   LIN  X              ; A = character, X++
23  FD OS VS             SPACE #(Y)          ; start bit (space)
26  P1 P2                PAD  2,P            ; start bit: the same pad as a data bit ...
28  8E 00                BCH+ S1             ; ... plus 22 cycles
2A  8E 00        S1:     BCH+ S2
2C  6A 00        S2:     LDI  UL,0
2E  FB                   SEC
2F  D1                   ROR                 ; C = bit 0, sentinel 1 -> bit 7 of A
30  83 05        OUT:    BCS+ ONE            ; send the bit in C
32  FD OS VS             SPACE #(Y)          ; bit 0 (space)
35  8E 04                BCH+ NXT
37  FD OM VM     ONE:    MARK #(Y)           ; bit 1 (mark)
3A  38                   NOP                 ; (both branches 33 cycles)
3B  P1 P2        NXT:    PAD  2,P            ; timing pad: 6..10 cycles
3D  D5                   SHR                 ; C = next bit
3E  BF FF                BII  A,&FF          ; A = 0 -> 8 bits sent
40  99 12                BZR- OUT
42  6E 00                CPI  UL,0           ; last data bit as long as the others
44  F9                   REC                 ; (11 cycles)
45  FD OM VM             MARK #(Y)           ; stop bit (mark)
48  6A KT                LDI  UL,KT          ; length of the stop bit
4A  88 02        TDLY:   LOP  UL,TDLY
4C  FD 62                DEC  UH
4E  99 2E                BZR- CHAR           ; next character
50  F9                   REC                 ; C=0: variable N unchanged
51  9A                   RTN
