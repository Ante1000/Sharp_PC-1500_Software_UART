; SERIN v6.2: the code UART7.3 installs for 1200..9600 bps.
; Machine code identical to v6.1 (v6.2 only changed BASIC prompts and tests).
;
; SERIN v6.1 - listing (addresses relative to SI = RAM+&130), 118 bytes
;
                 ; =====================================================================
                 ; SERIN v6.1 - software UART receiver 8N1 for the Sharp PC-1500(A),
                 ; 1200 / 2400 / 4800 / 9600 bps, input PB0 (pin 9) or PB2 (CMT-IN,
                 ; pin 27), normal polarity (TTL: idle = high) or
                 ; inverted (idle = low) - chosen in UART7.3.
                 ; CPU LH5801 @ 1.3 MHz.
                 ;
                 ; Call from BASIC:
                 ;   CALL SI          receive up to 255 characters
                 ;   CALL SI,M        receive at most M characters (1..255; 0 or >255 = 255)
                 ; Result:
                 ;   RC               number of characters received, 1 byte (0..255), RC = RX-1
                 ;   RX..RX+254       received characters (RX = start of a memory page, &4200)
                 ;   M                (only with CALL SI,M) = number of characters received
                 ;                    (return with C=1 -> the ROM writes X into the variable of CALL)
                 ; Time:
                 ;   the first character must come within ~30 s, the next ones < ~0.5 s apart;
                 ;   after the M-th (or 255th) character it returns at once. The time-outs do
                 ;   not depend on the baud rate.
                 ;
                 ; Code as in v6.0; the jumps that depend on the line state are pseudo-instructions
                 ; whose opcode UART7.3 writes (BZR and BZS take the same time, timing unchanged):
                 ;   BMK+ = FM   jump forward,  if line = mark   (BZR+ &89 / inv. BZS+ &8B)
                 ;   BSP+ = FS   jump forward,  if line = space  (BZS+ &8B / inv. BZR+ &89)
                 ;   BMK- = RM   jump backward, if line = mark   (BZR- &99 / inv. BZS- &9B)
                 ; Other BASIC variables written by UART7.3:
                 ;   DB = &FE (PB0) / &FB (PB2)  mask of the direction register DDB (bit = 0 -> input)
                 ;   BM = 1 (PB0) / 4 (PB2)      mask of the input bit in port B (&F00F)
                 ;   KB                          bit loop: 79.5 + 11*KB cycles (MAME; instruction +3)
                 ;   KH                          delay to the middle of the start bit
                 ;   bps    KB   KH   (KH chosen in the simulator: middle of the tolerance for
                 ;   1200   91   47    both cycle tables; 9600 = v55, tested on a PC-1500A)
                 ;   2400   42   21
                 ;   4800   17   12
                 ;   9600    5    3
                 ;
                 ; Load address: SI = RAM+&130 (&4130).
                 ; Symbols filled in by BASIC: RP = page of the RX buffer (RX = RP*256),
                 ; CP = RP-1 (counter RC = CP*256+&FF = RX-1).
                 ; The RX buffer starts at the start of a page, so the number of characters = XL.
                 ; Jumps: the LH5801 has separate opcodes for forward (+) and backward (-) jumps;
                 ; the offset is ALWAYS positive (0..255), counted from the next instruction.
                 ; The POKE lines of UART7.3 were generated from this file.
                 ; =====================================================================
00  FD BE                RIE                 ; no interrupts (timing!)
02  84                   LDA  XH             ; no variable (ROM address) or M>255
03  89 06                BZR+ MAXM           ;   -> 255 characters
05  04                   LDA  XL             ; CALL SI,M: X = M
06  8B 03                BZS+ MAXM           ; M = 0 -> 255 characters
08  DF                   DEC  A              ; r = M-1 (0..254)
09  8E 02                BCH+ SETM
0B  B5 FE        MAXM:   LDI  A,&FE          ; r = 254 -> 255 characters (whole buffer)
0D  AE CP FF     SETM:   STA  (CP,&FF)       ; RC = r (r+1 characters left)
10  48 RP                LDI  XH,RP          ; X = RX (start of a page)
12  4A 00                LDI  XL,0
14  58 F0                LDI  YH,&F0         ; Y = &F00D (DDB, direction register of port B)
16  5A 0D                LDI  YL,&0D
18  FD 59 DB             ANI  #(Y),DB        ; PB0 or PB2 = input
1B  54                   INC  Y
1C  54                   INC  Y              ; Y = &F00F (port B)
1D  68 00                LDI  UH,&00         ; time-out of the 1st character: 18*256*256 loops ~ 30 s
1F  B5 12                LDI  A,18
21  FD 5D BM     WH:     BII  #(Y),BM        ; wait for the idle state (1 = mark)
24  FM 0B                BMK+ WL             ; line = mark -> wait for the start bit
26  88 07                LOP  UL,WH          ; 256 loops x 33 cycles
28  FD 62                DEC  UH
2A  99 0B                BZR- WH
2C  DF                   DEC  A
2D  99 0E                BZR- WH
2F  8E 3D                BCH+ DONE           ; time-out
31  FD 5D BM     WL:     BII  #(Y),BM        ; wait for the edge 1->0 (start bit)
34  FS 0B                BSP+ START          ; line = space -> start bit
36  88 07                LOP  UL,WL
38  FD 62                DEC  UH
3A  99 0B                BZR- WL
3C  DF                   DEC  A
3D  99 0E                BZR- WL
3F  8E 2D                BCH+ DONE           ; time-out
41  6A KH        START:  LDI  UL,KH          ; ~half of the start bit
43  88 02        HALF:   LOP  UL,HALF
45  FD 5D BM             BII  #(Y),BM        ; middle of the start bit: still 0?
48  RM 19                BMK- WL             ; no -> noise, keep waiting
4A  68 08                LDI  UH,8           ; 8 data bits
4C  6A KB        BIT:    LDI  UL,KB          ; bit loop (KB as in SEROUT)
4E  88 02        DLY:    LOP  UL,DLY
50  38                   NOP                 ; (fine tuning: +10 cycles)
51  38                   NOP
52  FD 5D BM             BII  #(Y),BM
55  FB                   SEC
56  FM 01                BMK+ ONE            ; mark -> bit = 1
58  F9                   REC
59  D1           ONE:    ROR                 ; LSB first
5A  FD 62                DEC  UH
5C  99 12                BZR- BIT
5E  41                   SIN  X              ; store the character, X++
5F  A5 CP FF             LDA  (CP,&FF)       ; r = 0 -> that was the last allowed character
62  8B 0A                BZS+ DONE
64  DF                   DEC  A
65  AE CP FF             STA  (CP,&FF)
68  68 4D                LDI  UH,77          ; time-out between characters: 77*256 loops ~ 0.5 s
6A  B5 01                LDI  A,1
6C  9E 4D                BCH- WH             ; wait for the stop bit and the next character
6E  04           DONE:   LDA  XL             ; number of characters = XL (RX starts a page)
6F  AE CP FF             STA  (CP,&FF)       ; RC = number of characters received
72  48 00                LDI  XH,0           ; X = number of characters ...
74  FB                   SEC                 ; ... C=1: BASIC writes X into the variable of CALL SI,M
75  9A                   RTN
