; v6.2: kod maszynowy identyczny z v6.1 (instalator v6.2 zmienia tylko teksty i testy w BASIC-u).
; v6.2: machine code identical to v6.1 (installer v6.2 only changes BASIC prompts and tests).
;
; SERIN v6.1 - listing (adresy wzgledem SI = RAM+&130), 118 bajtow
;
                 ; =====================================================================
                 ; SERIN v6.1 - programowy odbiornik UART 8N1 dla Sharp PC-1500(A),
                 ; 1200 / 2400 / 4800 / 9600 bps, wejscie PB0 (pin 9) albo PB2 (CMT-IN,
                 ; pin 27), polaryzacja normalna (TTL: spoczynek = stan wysoki) albo
                 ; odwrocona (spoczynek = stan niski) - wybor w instalatorze.
                 ; CPU LH5801 @ 1,3 MHz.
                 ;
                 ; Wywolanie z BASIC-a:
                 ;   CALL SI          odbierz do 255 znakow
                 ;   CALL SI,M        odbierz najwyzej M znakow (1..255; 0 lub >255 = 255)
                 ; Wynik:
                 ;   RC               liczba odebranych znakow, 1 bajt (0..255), RC = RX-1
                 ;   RX..RX+254       odebrane znaki (RX = poczatek strony pamieci, &4200)
                 ;   M                (tylko przy CALL SI,M) = liczba odebranych znakow
                 ;                    (powrot z C=1 -> ROM wpisuje X do zmiennej z CALL)
                 ; Czas:
                 ;   pierwszy znak musi przyjsc w ciagu ~30 s, kolejne w odstepach < ~0,5 s,
                 ;   po M-tym (lub 255.) znaku powrot natychmiast. Timeouty nie zaleza od
                 ;   szybkosci transmisji.
                 ;
                 ; Kod jak w v6.0; skoki zalezne od stanu linii to pseudo-rozkazy, ktorych
                 ; kod wpisuje instalator (BZR i BZS trwaja tyle samo, czasy bez zmian):
                 ;   BMK+ = FM   skok w przod, gdy linia = mark   (BZR+ &89 / odwr. BZS+ &8B)
                 ;   BSP+ = FS   skok w przod, gdy linia = space  (BZS+ &8B / odwr. BZR+ &89)
                 ;   BMK- = RM   skok w tyl,   gdy linia = mark   (BZR- &99 / odwr. BZS- &9B)
                 ; Pozostale zmienne BASIC-a wpisywane przez instalator:
                 ;   DB = &FE (PB0) / &FB (PB2)  maska rejestru kierunku DDB (bit = 0 -> wejscie)
                 ;   BM = 1 (PB0) / 4 (PB2)      maska bitu wejscia w porcie B (&F00F)
                 ;   KB                          petla bitu: 79,5 + 11*KB cykli (MAME; instrukcja +3)
                 ;   KH                          opoznienie do srodka bitu startu
                 ;   bps    KB   KH   (KH dobrane w symulatorze: srodek tolerancji dla
                 ;   1200   91   47    obu tablic cykli; 9600 = v55, sprawdzone na PC-1500A)
                 ;   2400   42   21
                 ;   4800   17   12
                 ;   9600    5    3
                 ;
                 ; Adres ladowania: SI = RAM+&130 (&4130).
                 ; Symbole wstawiane przez BASIC: RP = strona bufora RX (RX = RP*256),
                 ; CP = RP-1 (licznik RC = CP*256+&FF = RX-1).
                 ; Bufor RX zaczyna sie od poczatku strony, wiec liczba znakow = XL.
                 ; Skoki: LH5801 ma osobne kody dla skokow w przod (+) i w tyl (-),
                 ; przesuniecie jest ZAWSZE dodatnie (0..255), liczone od nastepnego rozkazu.
                 ; Plik jest zrodlem dla tools/build_v61.py (asembler + generator POKE).
                 ; =====================================================================
00  FD BE                RIE                 ; bez przerwan (timing!)
02  84                   LDA  XH             ; bez zmiennej (adres w ROM) albo M>255
03  89 06                BZR+ MAXM           ;   -> 255 znakow
05  04                   LDA  XL             ; CALL SI,M: X = M
06  8B 03                BZS+ MAXM           ; M = 0 -> 255 znakow
08  DF                   DEC  A              ; r = M-1 (0..254)
09  8E 02                BCH+ SETM
0B  B5 FE        MAXM:   LDI  A,&FE          ; r = 254 -> 255 znakow (caly bufor)
0D  AE CP FF     SETM:   STA  (CP,&FF)       ; RC = r (pozostalo r+1 znakow)
10  48 RP                LDI  XH,RP          ; X = RX (poczatek strony)
12  4A 00                LDI  XL,0
14  58 F0                LDI  YH,&F0         ; Y = &F00D (DDB, rejestr kierunku portu B)
16  5A 0D                LDI  YL,&0D
18  FD 59 DB             ANI  #(Y),DB        ; PB0 lub PB2 = wejscie
1B  54                   INC  Y
1C  54                   INC  Y              ; Y = &F00F (port B)
1D  68 00                LDI  UH,&00         ; timeout 1. znaku: 18*256*256 obiegow ~ 30 s
1F  B5 12                LDI  A,18
21  FD 5D BM     WH:     BII  #(Y),BM        ; czekaj na stan spoczynkowy (1 = mark)
24  FM 0B                BMK+ WL             ; linia = mark -> czekaj na bit startu
26  88 07                LOP  UL,WH          ; 256 obiegow x 33 cykle
28  FD 62                DEC  UH
2A  99 0B                BZR- WH
2C  DF                   DEC  A
2D  99 0E                BZR- WH
2F  8E 3D                BCH+ DONE           ; timeout
31  FD 5D BM     WL:     BII  #(Y),BM        ; czekaj na zbocze 1->0 (bit startu)
34  FS 0B                BSP+ START          ; linia = space -> bit startu
36  88 07                LOP  UL,WL
38  FD 62                DEC  UH
3A  99 0B                BZR- WL
3C  DF                   DEC  A
3D  99 0E                BZR- WL
3F  8E 2D                BCH+ DONE           ; timeout
41  6A KH        START:  LDI  UL,KH          ; ~pol bitu startu
43  88 02        HALF:   LOP  UL,HALF
45  FD 5D BM             BII  #(Y),BM        ; srodek bitu startu: nadal 0?
48  RM 19                BMK- WL             ; nie -> zaklocenie, czekaj dalej
4A  68 08                LDI  UH,8           ; 8 bitow danych
4C  6A KB        BIT:    LDI  UL,KB          ; petla bitu (KB jak w SEROUT)
4E  88 02        DLY:    LOP  UL,DLY
50  38                   NOP                 ; (dostrojenie: +10 cykli)
51  38                   NOP
52  FD 5D BM             BII  #(Y),BM
55  FB                   SEC
56  FM 01                BMK+ ONE            ; mark -> bit = 1
58  F9                   REC
59  D1           ONE:    ROR                 ; LSB pierwszy
5A  FD 62                DEC  UH
5C  99 12                BZR- BIT
5E  41                   SIN  X              ; zapisz znak, X++
5F  A5 CP FF             LDA  (CP,&FF)       ; r = 0 -> to byl ostatni dozwolony znak
62  8B 0A                BZS+ DONE
64  DF                   DEC  A
65  AE CP FF             STA  (CP,&FF)
68  68 4D                LDI  UH,77          ; timeout miedzy znakami: 77*256 obiegow ~ 0,5 s
6A  B5 01                LDI  A,1
6C  9E 4D                BCH- WH             ; czekaj na bit stopu i kolejny znak
6E  04           DONE:   LDA  XL             ; liczba znakow = XL (RX zaczyna sie od strony)
6F  AE CP FF             STA  (CP,&FF)       ; RC = liczba odebranych znakow
72  48 00                LDI  XH,0           ; X = liczba znakow ...
74  FB                   SEC                 ; ... C=1: BASIC wpisze X do zmiennej z CALL SI,M
75  9A                   RTN
